# Token do bot (Discord Developer Portal → Bot → Reset Token)
BOT_TOKEN=

# Mesma chave cadastrada nos Secrets da Base44 (BOT_API_KEY)
BOT_API_KEY=

# Endereço da função bot-sync no painel (já preenchido)
API_URL=https://nexus-support-hub.base44.app/functions/bot-sync

# ID do seu servidor (ative o Modo de desenvolvedor no Discord e copie)
GUILD_ID=

# Intervalo da sincronização com o painel, em segundos (padrão 60)
SYNC_INTERVAL_SECONDS=60